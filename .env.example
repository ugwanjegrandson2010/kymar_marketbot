# MarketBot configuration. Copy to .env and fill in.
# The key is read from here or from the environment; it is never logged.

# --- CoinGecko (free demo key raises the rate limits) ---
MARKETBOT_COINGECKO_API_KEY=CG-Qiwk2Hu6vuqxAnWSsKW8cCUj

# --- backtest / paper trading ---
MARKETBOT_STARTING_CASH=10000
MARKETBOT_FEE_RATE=0.001
MARKETBOT_SLIPPAGE_RATE=0.0005
MARKETBOT_RISK_PER_TRADE=0.01
MARKETBOT_MAX_DRAWDOWN_PCT=0.20
MARKETBOT_MAX_DAILY_LOSS_PCT=0.03
MARKETBOT_ALLOW_SHORT=true

# --- live trading: ALL THREE are required, and the confirmation phrase is
# --- passed as an argument to LiveBroker, not read from here.
# MARKETBOT_LIVE_TRADING=1
# MARKETBOT_EXCHANGE=binance
# MARKETBOT_BINANCE_API_KEY=
# MARKETBOT_BINANCE_SECRET=
# MARKETBOT_BINANCE_SANDBOX=true

# --- rate limiting ---
MARKETBOT_REQUEST_MIN_INTERVAL=2.0
MARKETBOT_CACHE_TTL=1800
